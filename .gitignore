# ─────────────────────────────────────────────────────────────
# DesignFix monorepo root .gitignore
# ─────────────────────────────────────────────────────────────

.claude

# Dependencies
node_modules/
**/node_modules/
package-lock.json
.gradle/
**/.gradle/

# Build / compile output
build/
**/build/
out/
**/out/
dist/
**/dist/
*.vsix

# Testing / coverage
coverage/
**/coverage/
.vscode-test/

# Experiment + agentic-comparison data (large / machine-specific).
# Prefix globs, unanchored and directory-only: any folder whose name starts with
# these, at any depth. Covers _backup/_final/_old variants without new entries.
user_study_data*/
cline_data*/
/data/
/old_designFix_data/

# Local scratch / model outputs (keep if you decide to version them; ignored by default)
# /scripts/tmp/

# Checker results cached by the prompt-generation scripts. Content-addressed and
# regenerable, so there is nothing here worth versioning.
/scripts/.prompt_cache/

# RQ1/RQ2 prompt-sweep responses (large; same treatment as data/ and cline_data/).
/rq1/

# Environment / secrets
.env
.env.*
*.local

# Editor / IDE
.idea/
.vscode/launch.json
.vscode/settings.json
.claude/settings.local.json
.claude

# OS junk
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Component READMEs (kept local only, not published to the remote)
/DesignFix-Extension/README.md
/DesignFix-client/README.md

# Large binaries / archives / private review docs (uncomment/adjust as needed)
srcML_win_0_9_5.zip
*.pdf
Initial Reviews.docx
Metareview after my rebuttal.docx
Rebuttal Response to the initial reviews.docx
Participants Response.xlsx
